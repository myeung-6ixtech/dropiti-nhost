# Nhost CLI local secrets — copy this file to the repository root as `.secrets`
# https://docs.nhost.io/platform/cloud/secrets
#
# Use single quotes for values. No export keyword.

HASURA_GRAPHQL_ADMIN_SECRET = 'replace-with-hasura-admin-secret'
HASURA_GRAPHQL_JWT_SECRET = '{"type":"HS256","key":"replace-with-64-char-hex-or-dashboard-value"}'

# Managed Grafana admin password (nhost.toml [observability.grafana]; required for cloud config push)
GRAFANA_ADMIN_PASSWORD = 'replace-with-strong-password'

# Optional: for admin-only function routes using x-admin-secret (if injected into Functions runtime)
# ADMIN_SECRET = 'replace-with-long-random-string'

# Optional: platform landlord UUIDs for admin incoming-offers (Functions + admin console)
# DROPITI_PLATFORM_LANDLORD_USER_IDS = 'uuid1,uuid2'

# Transfer ownership + WhatsApp (v2 unified backend)
# DROPITI_CLIENT_ORIGIN = 'https://dropiti.com'
# WHATSAPP_PROVIDER = 'stub'
# WHATSAPP_API_TOKEN = 'replace-when-using-meta-or-twilio'
# WHATSAPP_PHONE_NUMBER_ID = 'replace-meta-phone-number-id'
# INVITATION_EXPIRY_DAYS = '7'

# Airwallex (v3 — server-only; never in admin console frontend)
# AIRWALLEX_API_KEY = 'replace-with-airwallex-api-key'
# AIRWALLEX_CLIENT_ID = 'replace-with-airwallex-client-id'
# AIRWALLEX_ENV = 'demo'
#

# Upstash rate limiting (v3 — moved from admin console)
# UPSTASH_REDIS_REST_URL = 'https://replace.upstash.io'
# UPSTASH_REDIS_REST_TOKEN = 'replace-with-upstash-token'

# Nhost Storage — create `dropiti-bucket` in Dashboard → Storage (public read for listing images)
MEDIA_STORAGE_BUCKET = 'dropiti-bucket'

# AWS S3 — optional fallback when MEDIA_STORAGE_BACKEND=s3
S3_BUCKET_ACCESS_KEY = 'replace-with-access-key'
S3_BUCKET_SECRET_KEY = 'replace-with-secret-key'
S3_BUCKET_NAME = 'tastyplates-bucket'
S3_BUCKET_AWS_REGION = 'ap-northeast-2'
S3_BUCKET_DOMAIN_URL = 'https://tastyplates-bucket.s3.ap-northeast-2.amazonaws.com'
